# =============================================================
# Hermes Stack — variáveis de ambiente
# Copie para .env e preencha os valores obrigatórios.
# =============================================================

# -------------------------------------------------------------
# UID / GID do host
# Mantém consistência de permissões nos volumes bind-mount.
# Linux: id -u  /  id -g
# macOS: UID geralmente começa em 501
# -------------------------------------------------------------
HERMES_UID=1000
HERMES_GID=1000

# -------------------------------------------------------------
# Modelo padrão para todos os agentes
# Deve corresponder a um model_name em litellm/litellm_config.yaml
# -------------------------------------------------------------
HERMES_MODEL=gemini-flash-lite

# -------------------------------------------------------------
# PostgreSQL — banco do LiteLLM
# -------------------------------------------------------------
LITELLM_POSTGRES_USER=litellm
LITELLM_POSTGRES_PASSWORD=troque-senha-postgres
LITELLM_POSTGRES_DB=litellm

# -------------------------------------------------------------
# LiteLLM
# master_key: prefixe com sk- . Usada para login em /ui e para
#             gerar as virtual keys abaixo.
# salt_key:   entropy adicional para hash das virtual keys.
# -------------------------------------------------------------
LITELLM_MASTER_KEY=sk-troque-master-key
LITELLM_SALT_KEY=sk-troque-salt-key

# Porta exposta na máquina host (apenas para uso direto / debug)
# Em produção, todo acesso passa pelo nginx na porta NGINX_PORT
LITELLM_PORT=4000

# -------------------------------------------------------------
# Provider — chave do provedor real consumido pelo LiteLLM
# Obtenha em https://aistudio.google.com/app/apikey
# -------------------------------------------------------------
GEMINI_API_KEY=troque-pela-sua-chave-gemini

# -------------------------------------------------------------
# Virtual keys do LiteLLM — geradas após o primeiro boot
#
# Procedimento:
#   1. docker compose up -d litellm-db litellm
#   2. Acesse http://localhost:4000/ui  (login com LITELLM_MASTER_KEY)
#   3. Virtual Keys → Create Key → crie uma key para cada usuário
#   4. Cole os valores abaixo e suba o resto da stack:
#      docker compose up -d
# -------------------------------------------------------------
LITELLM_USER_01_API_KEY=
LITELLM_USER_02_API_KEY=
LITELLM_USER_03_API_KEY=

# -------------------------------------------------------------
# Nginx — porta pública
# -------------------------------------------------------------
NGINX_PORT=80

# -------------------------------------------------------------
# Nginx — credenciais basic auth por usuário
#
# NGINX_USER_xx : nome de usuário para o login HTTP
# NGINX_PASS_xx : senha (texto claro aqui; o entrypoint converte
#                 em bcrypt e grava em .htpasswd no container)
#
# Rotas protegidas:
#   /chat01/ + /dash01/  →  NGINX_USER_01 / NGINX_PASS_01
#   /chat02/ + /dash02/  →  NGINX_USER_02 / NGINX_PASS_02
#   /chat03/ + /dash03/  →  NGINX_USER_03 / NGINX_PASS_03
# -------------------------------------------------------------
NGINX_USER_01=user01
NGINX_PASS_01=troque-senha-user01

NGINX_USER_02=user02
NGINX_PASS_02=troque-senha-user02

NGINX_USER_03=user03
NGINX_PASS_03=troque-senha-user03
